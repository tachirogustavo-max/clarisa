<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:marco="clr-namespace:Clarisa.Setup.Servicios">
 <Style x:Key="BotonVentana" TargetType="Button">
  <Setter Property="IsTabStop" Value="False"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#294B3A"/>
  <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Fondo" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fondo" Property="Background" Value="#E5EEE7"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fondo" Property="Background" Value="#D3E3D6"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fondo" Property="BorderBrush" Value="#126D3D"/><Setter TargetName="Fondo" Property="BorderThickness" Value="2"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Cerrar"/></MultiTrigger.Conditions><Setter TargetName="Fondo" Property="Background" Value="#B52330"/><Setter Property="Foreground" Value="White"/></MultiTrigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BotonCerrarVentana" TargetType="Button" BasedOn="{StaticResource BotonVentana}">
  <Setter Property="Tag" Value="Cerrar"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B52330"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="VentanaInstitucional" TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
  <Setter Property="Icon" Value="Resources/clarisa.ico"/>
  <Setter Property="WindowStyle" Value="None"/><Setter Property="marco:MarcoVentana.Activo" Value="True"/>
  <Setter Property="shell:WindowChrome.WindowChrome"><Setter.Value><shell:WindowChrome CaptionHeight="41" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
   <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="#C2D1C6" BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True">
    <Grid><Grid.RowDefinitions><RowDefinition Height="41"/><RowDefinition/></Grid.RowDefinitions>
     <Border x:Name="Cabecera" Background="#F5F8F4" BorderBrush="#DCE5DD" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Image Source="{TemplateBinding Icon}" Width="21" Height="21" Margin="8,0,0,0" Stretch="Uniform"/>
       <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#42624C" VerticalAlignment="Center" Margin="8,0,12,0"/>
       <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="Minimizar" Style="{StaticResource BotonVentana}" Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="Minimizar" AutomationProperties.Name="Minimizar ventana"><Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="11" Height="11"/></Button>
        <Button x:Name="Maximizar" Style="{StaticResource BotonVentana}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="Maximizar o restaurar" AutomationProperties.Name="Maximizar o restaurar ventana">
         <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12">
          <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M1,1 H10 V10 H1 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M3,1 H11 V9 M1,3 H9 V11 H1 Z"/></DataTrigger></Style.Triggers></Style></Path.Style>
         </Path>
        </Button>
        <Button Style="{StaticResource BotonCerrarVentana}" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar ventana"><Path Data="M1,1 L10,10 M10,1 L1,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="12" Height="12"/></Button>
       </StackPanel>
      </Grid>
     </Border>
     <AdornerDecorator Grid.Row="1"><ContentPresenter Content="{TemplateBinding Content}"/></AdornerDecorator>
    </Grid>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="WindowState" Value="Maximized"><Setter TargetName="Marco" Property="CornerRadius" Value="0"/><Setter TargetName="Cabecera" Property="CornerRadius" Value="0"/><Setter TargetName="Marco" Property="BorderThickness" Value="0"/></Trigger><Trigger Property="ResizeMode" Value="NoResize"><Setter TargetName="Minimizar" Property="Visibility" Value="Collapsed"/><Setter TargetName="Maximizar" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="ResizeMode" Value="CanMinimize"><Setter TargetName="Maximizar" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
