<Window x:Class="Clarisa.Setup.Vistas.DialogoCuentaInicial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuenta de Dirección" Style="{StaticResource VentanaInstitucional}"
        Width="560" Height="610" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
  <Border Background="White" Padding="28,24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
        <StackPanel Margin="0,0,10,0">
          <TextBlock Text="Prepara tu cuenta" FontFamily="{StaticResource Editorial}" FontSize="27"/>
          <TextBlock Text="Desde esta cuenta podrás organizar el año escolar y administrar el acceso del personal."
                     Style="{StaticResource Ayuda}" Margin="0,10,0,18"/>
          <WrapPanel Margin="0,0,0,20">
            <TextBlock Text="Usuario de acceso: " Foreground="{StaticResource Secundario}"/>
            <TextBlock x:Name="Usuario" FontWeight="SemiBold"/>
          </WrapPanel>
          <Label Content="Nombre y apellido" Target="{Binding ElementName=Nombre}"/>
          <TextBox x:Name="Nombre" MaxLength="80" AutomationProperties.Name="Nombre visible de la cuenta de Dirección"/>
          <Label Content="Contraseña" Target="{Binding ElementName=Clave}" Margin="0,18,0,0"/>
          <PasswordBox x:Name="Clave" MaxLength="256" AutomationProperties.Name="Contraseña de la cuenta de Dirección"/>
          <TextBlock Text="Usa una frase de al menos 15 caracteres. Puedes incluir espacios."
                     Style="{StaticResource Ayuda}" Margin="0,7,0,0"/>
          <Label Content="Repite la contraseña" Target="{Binding ElementName=Confirmacion}" Margin="0,18,0,0"/>
          <PasswordBox x:Name="Confirmacion" MaxLength="256" AutomationProperties.Name="Confirmación de contraseña"/>
          <TextBlock Text="Conserva esta contraseña: la necesitarás para entrar como Dirección."
                     Style="{StaticResource Ayuda}" Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1">
        <TextBlock x:Name="Error" Foreground="#A52C35" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,12"/>
        <WrapPanel HorizontalAlignment="Right">
          <Button Content="Cancelar" IsCancel="True" Margin="0,0,10,0"/>
          <Button x:Name="BotonContinuar" Content="Continuar" Style="{StaticResource Principal}" IsDefault="True" Click="Aceptar"/>
        </WrapPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
