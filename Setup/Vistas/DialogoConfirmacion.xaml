<Window x:Class="Clarisa.Setup.Vistas.DialogoConfirmacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar configuración" Style="{StaticResource VentanaInstitucional}"
        Width="580" Height="440" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
  <Border Background="White" Padding="28,24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Revisa antes de continuar" FontFamily="{StaticResource Editorial}" FontSize="26" Margin="0,0,0,16"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="Mensaje" TextWrapping="Wrap" Margin="0,0,12,0"/>
      </ScrollViewer>
      <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="BotonVolver" Content="Volver" IsCancel="True" IsDefault="True" Margin="0,0,10,0"/>
        <Button Content="Confirmar" Style="{StaticResource Principal}" Click="Confirmar"/>
      </WrapPanel>
    </Grid>
  </Border>
</Window>
