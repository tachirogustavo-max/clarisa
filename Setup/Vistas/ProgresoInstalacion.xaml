<UserControl x:Class="Clarisa.Setup.Vistas.ProgresoInstalacion" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="AjustarTamano">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="{Binding TituloProgreso}" FontFamily="{StaticResource Editorial}" FontSize="30"/>
   <TextBlock Text="{Binding DescripcionProgreso}" Style="{StaticResource Ayuda}" Margin="0,8,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#EEF5F0" BorderBrush="#18814B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" SizeChanged="AjustarTamano">
   <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Estaciones}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.ColumnSpan="2" Text="Datos para instalar las estaciones (anótalos o cópialos; también quedan en el registro)" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="1" Text="Dirección" VerticalAlignment="Center" Margin="0,0,12,4"/>
    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Estaciones.Direccion, Mode=OneWay}" IsReadOnly="True" Padding="6,3" MinHeight="0" Margin="0,0,0,4" AutomationProperties.Name="Dirección del servidor para las estaciones"/>
    <TextBlock Grid.Row="2" Text="Certificado" VerticalAlignment="Center" Margin="0,0,12,4"/>
    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Estaciones.Certificado, Mode=OneWay}" IsReadOnly="True" Padding="6,3" MinHeight="0" Margin="0,0,0,4" AutomationProperties.Name="Archivo del certificado para las estaciones"/>
    <TextBlock Grid.Row="3" Text="Huella" VerticalAlignment="Center" Margin="0,0,12,4"/>
    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Estaciones.Huella, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Padding="6,3" MinHeight="0" Margin="0,0,0,4" AutomationProperties.Name="Huella de verificación para las estaciones"/>
    <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0">
     <Button Content="Copiar los tres datos" Click="CopiarDatos" Padding="12,5" MinHeight="0" Margin="0,0,8,0"/>
     <Button Content="Abrir la carpeta del certificado" Click="AbrirCarpeta" Padding="12,5" MinHeight="0" Margin="0,0,10,0"/>
     <TextBlock x:Name="Copiado" VerticalAlignment="Center" FontSize="12" Foreground="#5B6B60"/>
    </WrapPanel>
   </Grid>
  </Border>
  <ListBox x:Name="Lista" Grid.Row="2" ItemsSource="{Binding Pasos}" SelectedItem="{Binding PasoActual, Mode=OneWay}" SelectionChanged="SeguirPaso" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Tinta}" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Item" Padding="0,8,12,8" AutomationProperties.Name="Progreso de la instalación">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <Grid MinHeight="78">
     <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Width="2" Background="#DCE5DF" HorizontalAlignment="Center" Margin="0,29,0,0">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Ultimo}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <Border x:Name="LineaAprobada" Background="#18814B" RenderTransformOrigin="0.5,0">
       <Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform>

      </Border>
     </Border>
     <Border x:Name="Circulo" Width="28" Height="28" CornerRadius="14" BorderBrush="#CEDAD1" BorderThickness="1.5" Background="#F7F9F5" VerticalAlignment="Top" HorizontalAlignment="Center">
      <Grid>
       <Ellipse x:Name="Pendiente" Width="6" Height="6" Fill="#9CAE9F"/>
       <Path x:Name="Marca" Data="M1,6 L5,10 L12,2" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="13" Stretch="Uniform" Visibility="Collapsed"/>
       <Ellipse x:Name="Trabajando" Width="17" Height="17" Stroke="#126D3D" StrokeThickness="2" StrokeDashArray="2,2" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
       <TextBlock x:Name="Aviso" Text="!" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <Grid Grid.Column="1" Margin="10,3,8,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="15" Margin="0,0,12,0"/>
       <TextBlock x:Name="Estado" Grid.Column="1" Text="{Binding Estado}" HorizontalAlignment="Right" Foreground="#6D7A71" FontSize="12" Margin="0,2,0,0"/>
      </Grid>
      <TextBlock x:Name="Detalle" Grid.Row="1" Text="{Binding Detalle}" Style="{StaticResource Ayuda}" Margin="0,7,0,0" MaxHeight="105" TextTrimming="WordEllipsis" ToolTip="{Binding Detalle}" Visibility="Collapsed"/>
     </Grid>
    </Grid>
    <DataTemplate.Triggers>
     <DataTrigger Binding="{Binding DataContext.MostrarDetalles, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter TargetName="Detalle" Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding Estado}" Value="Aprobado"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="LineaAprobada" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.35"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions><Setter TargetName="Circulo" Property="Background" Value="#18814B"/><Setter TargetName="Circulo" Property="BorderBrush" Value="#18814B"/><Setter TargetName="Marca" Property="Visibility" Value="Visible"/><Setter TargetName="Pendiente" Property="Visibility" Value="Collapsed"/><Setter TargetName="Estado" Property="Foreground" Value="#126D3D"/></DataTrigger>
     <DataTrigger Binding="{Binding Estado}" Value="En curso"><Setter TargetName="Circulo" Property="BorderBrush" Value="#126D3D"/><Setter TargetName="Trabajando" Property="Visibility" Value="Visible"/><Setter TargetName="Pendiente" Property="Visibility" Value="Collapsed"/><Setter TargetName="Estado" Property="Foreground" Value="#126D3D"/>
      <DataTrigger.EnterActions><BeginStoryboard x:Name="Giro"><Storyboard><DoubleAnimation Storyboard.TargetName="Trabajando" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.8" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
      <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Giro"/></DataTrigger.ExitActions>
     </DataTrigger>
     <DataTrigger Binding="{Binding Estado}" Value="Fallido"><Setter TargetName="Circulo" Property="Background" Value="#FAE8E8"/><Setter TargetName="Circulo" Property="BorderBrush" Value="#B5444A"/><Setter TargetName="Aviso" Property="Visibility" Value="Visible"/><Setter TargetName="Aviso" Property="Foreground" Value="#A12E36"/><Setter TargetName="Pendiente" Property="Visibility" Value="Collapsed"/><Setter TargetName="Estado" Property="Foreground" Value="#A12E36"/><Setter TargetName="Detalle" Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding Estado}" Value="Sin comprobar"><Setter TargetName="Estado" Property="Foreground" Value="#986322"/><Setter TargetName="Detalle" Property="Visibility" Value="Visible"/></DataTrigger>
    </DataTemplate.Triggers>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="3" Margin="0,14,0,0">
   <CheckBox Content="Mostrar detalles técnicos" IsChecked="{Binding MostrarDetalles}" Checked="CambiarDetalle" Unchecked="CambiarDetalle" Margin="0,0,0,8"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="120">
    <ItemsControl ItemsSource="{Binding Indicaciones}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Ayuda}" Margin="0,5,12,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
  </StackPanel>
 </Grid>
</UserControl>
