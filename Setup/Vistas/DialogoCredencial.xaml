<Window x:Class="Clarisa.Setup.Vistas.DialogoCredencial" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="540" Height="480" MinWidth="420" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" Title="Acceso de configuración" Style="{StaticResource VentanaInstitucional}">
 <Border Background="White" Padding="26,22">
  <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18"><StackPanel Margin="0,0,10,0">
    <TextBlock x:Name="Encabezado" FontFamily="{StaticResource Editorial}" FontSize="26"/>
    <TextBlock x:Name="Descripcion" Style="{StaticResource Ayuda}" Margin="0,10,0,16"/>
    <Label Content="Contraseña"/><PasswordBox x:Name="Clave" MaxLength="256"/>
    <StackPanel x:Name="PanelConfirmacion" Margin="0,14,0,0"><Label Content="Repite la contraseña"/><PasswordBox x:Name="Confirmacion" MaxLength="256"/></StackPanel>
    <TextBlock x:Name="Error" Foreground="#A52C35" Margin="0,10" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></ScrollViewer>
   <WrapPanel Grid.Row="1" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Margin="0,0,10,0"/><Button Content="Continuar" Style="{StaticResource Principal}" Click="Aceptar" IsDefault="True"/></WrapPanel>
  </Grid>
 </Border>
</Window>
