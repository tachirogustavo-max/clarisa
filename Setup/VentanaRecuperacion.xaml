<Window x:Class="Clarisa.Setup.VentanaRecuperacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar una copia · Sistema de Control Académico La Clarisa" Icon="Resources/clarisa.ico"
        Width="920" Height="800" MinWidth="700" MinHeight="620"
        Style="{StaticResource VentanaInstitucional}" WindowStartupLocation="CenterScreen" Closing="CerrarVentana">
  <Grid Margin="28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Sistema de Control Académico La Clarisa" Foreground="{StaticResource Secundario}" TextWrapping="Wrap"/>
      <TextBlock Text="Recuperar una copia de seguridad" FontFamily="{StaticResource Editorial}" FontSize="28" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="22">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0" IsEnabled="{Binding HayServidor}">
          <TextBlock Text="1. Elige la copia" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource Ayuda}" Text="Las copias del servidor terminan en .liceo-respaldo. También puedes elegir una guardada en un pendrive."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Copia, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Copia elegida"/>
            <Button Grid.Column="1" Content="Elegir copia…" Click="ElegirCopia" Margin="10,0,0,0"/>
          </Grid>
          <Expander Header="La copia viene de otro servidor" Margin="0,14,0,0">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Style="{StaticResource Ayuda}" Text="Elige el archivo de recuperación de la clave de ese servidor (el que se guardó fuera del equipo al instalarlo)."/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding ClaveRecuperacion, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Archivo de recuperación de la clave"/>
                <Button Grid.Column="1" Content="Elegir archivo…" Click="ElegirClave" Margin="10,0,0,0"/>
              </Grid>
            </StackPanel>
          </Expander>
          <Button Content="Comprobar copia" Click="Comprobar" IsEnabled="{Binding PuedeComprobar}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          <ItemsControl ItemsSource="{Binding Resumen}" Margin="0,12,0,0" FontFamily="Consolas" FontSize="12">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Secundario}"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="2. Confirma" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,0"/>
          <TextBlock Style="{StaticResource Ayuda}" Text="La copia se carga en una base nueva. La información actual no se borra: siempre puedes volver a ella con el botón de abajo."/>
          <Label Content="_Contraseña de mantenimiento" Target="{Binding ElementName=Contrasena}"/>
          <PasswordBox x:Name="Contrasena" MaxLength="256" HorizontalAlignment="Left" Width="320" AutomationProperties.Name="Contraseña de mantenimiento"/>
          <TextBlock Style="{StaticResource Ayuda}" Text="Es la que se eligió en «Protege el mantenimiento» al instalar el servidor. No es la contraseña de la aplicación."/>
          <CheckBox IsChecked="{Binding Entendido}" Content="Entiendo que el servidor se detendrá unos minutos y que todos deberán volver a iniciar sesión."/>
          <ItemsControl ItemsSource="{Binding Pasos}" Margin="0,16,0,0">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='✓ {0}'}" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Content="Volver a la información anterior" Click="Volver" IsEnabled="{Binding PuedeVolver}" HorizontalAlignment="Left"/>
        <WrapPanel Grid.Column="1">
          <Button Content="Cerrar" Click="Cerrar" Margin="0,0,10,0"/>
          <Button Content="Recuperar" Click="Recuperar" Style="{StaticResource Principal}" IsEnabled="{Binding PuedeRecuperar}"/>
        </WrapPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
