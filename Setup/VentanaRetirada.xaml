<Window x:Class="Clarisa.Setup.VentanaRetirada"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:m="clr-namespace:Clarisa.Setup.Modelos"
        xmlns:v="clr-namespace:Clarisa.Setup.Vistas"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=m:ModeloRetirada, IsDesignTimeCreatable=True}"
        Title="Retirar programas · Sistema de Control Académico La Clarisa" Icon="Resources/clarisa.ico"
        Width="920" Height="780" MinWidth="700" MinHeight="620"
        Style="{StaticResource VentanaInstitucional}" WindowStartupLocation="CenterScreen"
        Closing="CerrarVentana" Loaded="Iniciar">
  <Grid Margin="28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Sistema de Control Académico La Clarisa" Foreground="{StaticResource Secundario}" TextWrapping="Wrap"/>
      <TextBlock Text="Retirar los programas de este equipo" FontFamily="{StaticResource Editorial}" FontSize="28" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="22">
      <Grid>
        <ScrollViewer Visibility="{Binding RevisionVisible, Converter={StaticResource Visible}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Antes de continuar" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Se retirarán únicamente los componentes propios que se puedan comprobar. La base de datos, los respaldos y las claves se conservan." Foreground="{StaticResource Secundario}" Margin="0,0,0,18"/>
            <ItemsControl ItemsSource="{Binding Problemas}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Mensaje}" Foreground="#A52C35" Margin="0,0,0,12"/></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Advertencias}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" Foreground="#795C1D" Margin="0,0,0,12"/></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Se retira" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding SeRetira}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#E0E7DC" BorderThickness="0,0,0,1" Padding="0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Ubicacion}" Foreground="{StaticResource Secundario}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <v:ProgresoInstalacion x:Name="ProgresoRetirada" Visibility="{Binding ProgresoVisible, Converter={StaticResource Visible}}"/>
      </Grid>
    </Border>
    <Expander Grid.Row="2" Header="Información que se conserva" IsExpanded="{Binding RevisionVisible, Mode=OneWay}" Margin="0,14,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="150">
        <ItemsControl ItemsSource="{Binding SeConserva}" Margin="4,8,12,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Ubicacion}" Foreground="{StaticResource Secundario}" FontSize="12"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Expander>
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Mensaje}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Content="Abrir registro" Click="AbrirRegistro" HorizontalAlignment="Left" Visibility="{Binding MostrarRegistro, Converter={StaticResource Visible}}"/>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
          <Button x:Name="BotonCerrar" Content="Cerrar" IsDefault="True" Click="Cerrar" Margin="0,0,10,0"/>
          <Button Content="Detener al terminar este paso" Click="Detener" IsEnabled="{Binding PuedeDetener}"
                  Visibility="{Binding Ocupado, Converter={StaticResource Visible}}"/>
          <Button x:Name="BotonRetirar" Content="Retirar programas" Click="Retirar" Style="{StaticResource Principal}"
                  IsEnabled="{Binding PuedeRetirar}" Visibility="{Binding RevisionVisible, Converter={StaticResource Visible}}"/>
        </WrapPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
