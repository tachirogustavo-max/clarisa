<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Clarisa.Desktop.Controls" x:Class="Clarisa.Desktop.Controls.IndicadorConfirmacion" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Guardado confirmado">
 <UserControl.Style>
  <Style TargetType="local:IndicadorConfirmacion">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <Trigger Property="Activo" Value="True">
     <Setter Property="Visibility" Value="Visible"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Style>
 <StackPanel Orientation="Horizontal">
  <Border Background="#E7F4E9" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
   <Path x:Name="Trazo" Data="M 3,9 L 8,14 L 18,3" Stroke="{DynamicResource Acento}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="14" Stretch="Uniform"/>
  </Border>
  <TextBlock Text="Guardado confirmado" Foreground="{DynamicResource Acento}" FontSize="12" VerticalAlignment="Center"/>
 </StackPanel>
</UserControl>
