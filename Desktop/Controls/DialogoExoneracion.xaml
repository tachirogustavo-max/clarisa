<UserControl x:Class="Clarisa.Desktop.Controls.DialogoExoneracion" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Visible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
 <Grid Background="#7018392A" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Teclas">
  <Border Background="White" CornerRadius="12" Padding="28" Margin="24" MaxWidth="570" VerticalAlignment="Center">
   <StackPanel>
    <TextBlock Text="{Binding Accion}" FontFamily="{DynamicResource FuenteEditorial}" FontSize="27"/>
    <TextBlock Text="{Binding Estudiante}" FontWeight="SemiBold" Margin="0,16,0,8"/>
    <TextBlock Text="{Binding Explicacion}" TextWrapping="Wrap" Foreground="{DynamicResource TextoSecundario}"/>
    <TextBlock Text="{Binding MotivoAnterior}" TextWrapping="Wrap" Foreground="{DynamicResource TextoSecundario}" FontSize="12" Margin="0,8,0,0"/>
    <Label Content="Motivo" Style="{StaticResource Etiqueta}" Margin="0,18,0,0"/>
    <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" IsEnabled="{Binding Disponible}"/>
    <TextBlock Text="{Binding ErrorMotivo}" Style="{StaticResource ErrorCampo}"/>
    <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive"/>
    <TextBlock Text="{Binding AvisoSalida}" Style="{StaticResource ErrorCampo}" AutomationProperties.LiveSetting="Assertive"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
     <Button Content="Cerrar" Click="Cerrar" IsEnabled="{Binding Disponible}" Style="{StaticResource BotonTexto}" Margin="0,0,12,0"/>
     <Button Content="Confirmar" Click="Confirmar">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BotonPrincipal}"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding Guardando}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding DebeConsultar}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
