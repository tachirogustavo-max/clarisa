<UserControl x:Class="Clarisa.Desktop.Controls.SelectorEvaluacion" x:Name="Selector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:Clarisa.Desktop.Presentation.Converters">
 <UserControl.Resources>
  <conv:ModalidadSeleccionada x:Key="ModalidadSeleccionada"/>
  <Style TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="RadioButton">
     <Border x:Name="Marco" Background="White" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="8" Padding="10,12" Margin="0,0,8,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Ellipse x:Name="Aro" Stroke="{DynamicResource Borde}" StrokeThickness="1.5"/>
        <Ellipse x:Name="Marca" Fill="{DynamicResource Acento}" Margin="4" Visibility="Collapsed"/>
       </Grid>
       <ContentPresenter Grid.Column="1"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Marco" Property="Background" Value="#F0F6ED"/><Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Acento}"/><Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource Acento}"/><Setter TargetName="Marca" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Foco}"/><Setter TargetName="Marco" Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Marco" Property="Opacity" Value="0.6"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <UniformGrid Columns="3" KeyboardNavigation.DirectionalNavigation="Cycle">
  <RadioButton IsChecked="{Binding Modalidad, ElementName=Selector, Converter={StaticResource ModalidadSeleccionada}, ConverterParameter=2, Mode=TwoWay}" AutomationProperties.Name="Cuantitativa, notas numéricas">
   <StackPanel><TextBlock Text="Cuantitativa" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Notas del 1 al 20." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextoSecundario}" Margin="0,5,0,0"/></StackPanel>
  </RadioButton>
  <RadioButton IsChecked="{Binding Modalidad, ElementName=Selector, Converter={StaticResource ModalidadSeleccionada}, ConverterParameter=3, Mode=TwoWay}" AutomationProperties.Name="Cualitativa, calificaciones con letras">
   <StackPanel><TextBlock Text="Cualitativa" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Letras de la escala del año." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextoSecundario}" Margin="0,5,0,0"/></StackPanel>
  </RadioButton>
  <RadioButton IsChecked="{Binding Modalidad, ElementName=Selector, Converter={StaticResource ModalidadSeleccionada}, ConverterParameter=4, Mode=TwoWay}" AutomationProperties.Name="Cuantitativa y cualitativa">
   <StackPanel><TextBlock Text="Ambas" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Una nota y una letra." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextoSecundario}" Margin="0,5,0,0"/></StackPanel>
  </RadioButton>
 </UniformGrid>
</UserControl>
