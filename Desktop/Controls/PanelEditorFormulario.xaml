<ContentControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:convertidores="clr-namespace:Clarisa.Desktop.Presentation.Converters" x:Class="Clarisa.Desktop.Controls.PanelEditorFormulario" Focusable="False" xmlns:foco="clr-namespace:Clarisa.Desktop.Presentation.Behaviors" foco:FocoModal.Activo="{Binding EditorVisible}">
 <ContentControl.Resources><convertidores:EspacioCompacto x:Key="EspacioEditor"/></ContentControl.Resources>
 <ContentControl.Tag>
  <MultiBinding Converter="{StaticResource EspacioEditor}">
   <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
   <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
  </MultiBinding>
 </ContentControl.Tag>
 <ContentControl.Style>
  <Style TargetType="ContentControl">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding EditorVisible}" Value="True">
     <Setter Property="Visibility" Value="Visible"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
 </ContentControl.Style>
 <ContentControl.Template>
  <ControlTemplate TargetType="ContentControl">
   <Grid Background="#88173529" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="TeclasEditor">
    <Border Background="White" CornerRadius="12" MaxWidth="640" MaxHeight="760">
     <Border.Style>
      <Style TargetType="Border">
       <Setter Property="Padding" Value="28"/><Setter Property="Margin" Value="24"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
         <Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="16"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,24">
       <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="{Binding TituloFormulario}" FontFamily="{DynamicResource FuenteEditorial}" FontSize="29"/>
       </StackPanel>
       <Button Grid.Column="1" Content="×" FontSize="21" Style="{StaticResource BotonTexto}" VerticalAlignment="Top" Margin="14,0,0,0" Click="Cerrar" AutomationProperties.Name="Cerrar formulario"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
       <ScrollViewer.Style>
        <Style TargetType="ScrollViewer">
         <Style.Triggers>
          <DataTrigger Binding="{Binding GuardandoFormulario}" Value="True">
           <Setter Property="IsEnabled" Value="False"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </ScrollViewer.Style>
       <ContentPresenter Content="{TemplateBinding Content}"/>
      </ScrollViewer>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="80">
       <ScrollViewer.Style>
        <Style TargetType="ScrollViewer"><Style.Triggers>
         <DataTrigger Binding="{Binding ErrorFormulario}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style>
       </ScrollViewer.Style>
       <TextBlock Text="{Binding ErrorFormulario}" TextWrapping="Wrap" Foreground="{DynamicResource Error}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
      </ScrollViewer>
      <Grid Grid.Row="3" Margin="0,22,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBlock Text="Confirmando…" VerticalAlignment="Center" Foreground="{DynamicResource TextoSecundario}">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding GuardandoFormulario}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource BotonTexto}" Click="Cerrar" Margin="0,0,12,0"/>
       <Button Grid.Column="2" Content="{Binding TextoGuardarFormulario}" Style="{StaticResource BotonPrincipal}" Click="Guardar"/>
      </Grid>
     </Grid>
    </Border>
    <Grid Background="#AA173529">
     <Grid.Style>
      <Style TargetType="Grid">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding DescartarVisible}" Value="True">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Grid.Style>
     <Border MaxWidth="430" Padding="28" CornerRadius="10" Background="White" VerticalAlignment="Center" Margin="24" KeyboardNavigation.TabNavigation="Cycle">
      <StackPanel>
       <TextBlock Text="¿Descartar estos cambios?" TextWrapping="Wrap" FontSize="23" FontWeight="SemiBold"/>
       <TextBlock Text="Esta edición todavía no se ha guardado en el servidor." TextWrapping="Wrap" Margin="0,14,0,24"/>
       <WrapPanel HorizontalAlignment="Right">
        <Button Content="Seguir editando" Style="{StaticResource BotonTexto}" Click="Seguir" Margin="0,0,10,0"/>
        <Button Content="Descartar" Style="{StaticResource BotonPrincipal}" Click="Descartar"/>
       </WrapPanel>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </ControlTemplate>
 </ContentControl.Template>
</ContentControl>
