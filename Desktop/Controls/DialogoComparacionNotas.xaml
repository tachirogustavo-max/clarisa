<UserControl x:Class="Clarisa.Desktop.Controls.DialogoComparacionNotas"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:foco="clr-namespace:Clarisa.Desktop.Presentation.Behaviors" foco:FocoModal.Activo="{Binding Visible}">
 <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Visible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></UserControl.Style>
 <Grid Background="#88173529" KeyboardNavigation.TabNavigation="Cycle">
  <Border Background="White" CornerRadius="12" Padding="28" Margin="24" MaxWidth="900" MaxHeight="650">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="Revisar cambios de notas" FontSize="29" FontFamily="{DynamicResource FuenteEditorial}" />
    <TextBlock Grid.Row="1" Text="Compara tu edición con la copia actual del servidor. Nada se sobrescribe hasta que vuelvas a guardar." Foreground="{DynamicResource TextoSecundario}" Margin="0,12,0,24" />
    <DataGrid Grid.Row="2" ItemsSource="{Binding Filas}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="White" BorderBrush="{DynamicResource Borde}" MinRowHeight="60">
     <DataGrid.Columns><DataGridTextColumn Header="Estudiante" Binding="{Binding Estudiante}" IsReadOnly="True" Width="*" MinWidth="160" /><DataGridTextColumn Header="Tu edición" Binding="{Binding MiNota}" IsReadOnly="True" Width="100" /><DataGridTextColumn Header="Servidor" Binding="{Binding NotaServidor}" IsReadOnly="True" Width="130" /><DataGridTemplateColumn Header="Qué conservar" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Opciones}" DisplayMemberPath="Texto" SelectedItem="{Binding Decision}" AutomationProperties.Name="Elegir la nota que se conservará" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="3" Text="{Binding Mensaje}" Foreground="{DynamicResource Error}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Assertive" />
    <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Seguir revisando mi copia" Style="{StaticResource BotonTexto}" Click="Cancelar" Margin="0,0,12,0" /><Button Content="Aplicar selección" Style="{StaticResource BotonPrincipal}" Click="Aplicar" /></WrapPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
