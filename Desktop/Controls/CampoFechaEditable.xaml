<UserControl x:Class="Clarisa.Desktop.Controls.CampoFechaEditable" x:Name="Raiz" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="True" GotKeyboardFocus="RecibirFoco">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
  <TextBox x:Name="Entrada" Text="{Binding Texto, ElementName=Raiz, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" ToolTip="Día/mes/año · dd/MM/aaaa" AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), ElementName=Raiz}"/>
  <Button Grid.Column="1" Click="AbrirCalendario" Style="{StaticResource BotonTexto}" Padding="10" Margin="8,0,0,0" AutomationProperties.Name="Abrir calendario">
   <Path Data="M1,4 H19 V20 H1 Z M1,9 H19 M5,0 V6 M15,0 V6" Stroke="{DynamicResource Acento}" StrokeThickness="1.5" Width="18" Height="20" Stretch="Uniform"/>
  </Button>
  <Popup x:Name="Desplegable" Placement="Bottom" PlacementTarget="{Binding ElementName=Entrada}" StaysOpen="False" AllowsTransparency="True">
   <Border Background="White" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="7" Padding="7">
    <Calendar x:Name="Calendario" SelectionMode="SingleDate" SelectedDatesChanged="ElegirFecha" PreviewKeyDown="TeclasCalendario" FontFamily="{DynamicResource FuenteInterfaz}" Language="{Binding Language, ElementName=Raiz}"/>
   </Border>
  </Popup>
 </Grid>
</UserControl>
