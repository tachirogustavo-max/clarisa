<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Clarisa.Desktop.Controls" xmlns:convertidores="clr-namespace:Clarisa.Desktop.Presentation.Converters" xmlns:comportamientos="clr-namespace:Clarisa.Desktop.Presentation.Behaviors" x:Class="Clarisa.Desktop.Controls.ListadoCatalogo" Background="White" Loaded="Cargar">
 <UserControl.Resources><convertidores:AnchoCompacto x:Key="AnchoListado"/></UserControl.Resources>
 <UserControl.Tag><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" Converter="{StaticResource AnchoListado}"/></UserControl.Tag>
 <Grid>
  <ScrollViewer x:Name="PaginaListado" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
   <Grid MinHeight="500" Height="{Binding ViewportHeight, ElementName=PaginaListado}">
  <Grid x:Name="ContenidoBase" Margin="32,28,32,18">
   <Grid.Style>
    <Style TargetType="Grid">
     <Style.Triggers>
      <DataTrigger Binding="{Binding EditorVisible}" Value="True">
       <Setter Property="IsEnabled" Value="False"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Grid.Style>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid Margin="0,0,0,28">
    <Grid.ColumnDefinitions>
     <ColumnDefinition/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,18,0">
     <TextBlock Text="{Binding Titulo}" FontFamily="{DynamicResource FuenteEditorial}">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="36"/>
       <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=local:ListadoCatalogo}}" Value="True"><Setter Property="FontSize" Value="28"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
     <TextBlock Text="{Binding Descripcion}" Foreground="{DynamicResource TextoSecundario}" Margin="0,8,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" Style="{StaticResource BotonPrincipal}" Click="Nuevo" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="+" FontSize="21" Margin="0,0,10,0"/>
      <TextBlock Text="{Binding TextoNuevo}" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
   </Grid>
   <Border Grid.Row="1" Background="#F7F9F5" CornerRadius="9" Padding="16" Margin="0,0,0,18">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
      <StackPanel.Style>
       <Style TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding RequiereAnio}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </StackPanel.Style>
      <Label Content="Año escolar" Style="{StaticResource Etiqueta}"/>
      <ComboBox ItemsSource="{Binding OpcionesAnio}" DisplayMemberPath="Nombre" SelectedItem="{Binding AnioSeleccionado}" SelectionChanged="CambiarAnio" MaxWidth="240" HorizontalAlignment="Left" MinWidth="180" AutomationProperties.Name="Año escolar del listado"/>
     </StackPanel>
     <StackPanel Grid.Row="1" Margin="0,0,12,0">
      <Label Content="_Buscar" Target="{Binding ElementName=CampoBuscar}" Style="{StaticResource Etiqueta}"/>
      <TextBox x:Name="CampoBuscar" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" comportamientos:ConsultaAutomatica.Activa="True" KeyDown="TeclasBusqueda" MaxLength="80" AutomationProperties.Name="Buscar en el listado"/>
     </StackPanel>
     <Button Grid.Row="1" Grid.Column="1" Content="Buscar" Style="{StaticResource BotonTexto}" Click="Buscar" VerticalAlignment="Bottom" Margin="0,0,16,0"/>
     <CheckBox Grid.Row="1" Grid.Column="2" Content="Incluir inactivos" IsChecked="{Binding IncluirInactivos}" comportamientos:ConsultaAutomatica.Activa="True" VerticalAlignment="Bottom" Margin="0,0,0,8">
      <CheckBox.Style>
       <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding MostrarInactivos}" Value="False">
          <Setter Property="Visibility" Value="Collapsed"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </CheckBox.Style>
     </CheckBox>
    </Grid>
   </Border>
   <DataGrid x:Name="Tabla" Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding Elementos}" SelectedItem="{Binding Seleccionado}" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" EnableRowVirtualization="True" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EDE5" BorderBrush="{DynamicResource Borde}" BorderThickness="1" Background="White" RowBackground="White" AlternatingRowBackground="#FAFCF8" MinRowHeight="52" SelectionMode="Single" MouseDoubleClick="Editar" PreviewKeyDown="TeclasTabla">
    <DataGrid.Resources>
     <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#EDF3ED"/>
      <Setter Property="Foreground" Value="{DynamicResource Tinta}"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
     </Style>
     <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Tinta}"/>
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
         <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
          <ContentPresenter VerticalAlignment="Center"/>
         </Border>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
      <Style.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#DEEBDD"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Background" Value="#D9E7F0"/>
       </Trigger>
      </Style.Triggers>
     </Style>
    </DataGrid.Resources>
   </DataGrid>
   <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,42,28,12" IsHitTestVisible="False">
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SinResultados}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="No hay información para mostrar" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="Revisa los filtros o registra el primer elemento." Foreground="{DynamicResource TextoSecundario}" Margin="0,10,0,0" TextAlignment="Center"/>
   </StackPanel>
   <StackPanel Grid.Row="3">
    <ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource Acento}" Margin="0,4,0,0">
     <ProgressBar.Style>
      <Style TargetType="ProgressBar">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Cargando}" Value="True">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </ProgressBar.Style>
    </ProgressBar>
    <local:BarraPaginacion/>
    <local:IndicadorConfirmacion Activo="{Binding GuardadoConfirmado}" Margin="0,6,0,0"/>
    <Grid Margin="0,8,0,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Mensaje}" Foreground="{DynamicResource TextoSecundario}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Margin="0,0,16,0"/>
     <Button Grid.Column="1" Content="{Binding TextoEditar}" Style="{StaticResource BotonTexto}" Click="EditarSeleccion"/>
    </Grid>
   </StackPanel>
  </Grid>
   </Grid>
  </ScrollViewer>
  <local:PanelEditorFormulario>
   <ContentPresenter Content="{Binding}" ContentTemplate="{Binding Editor, RelativeSource={RelativeSource AncestorType=local:ListadoCatalogo}}"/>
  </local:PanelEditorFormulario>
 </Grid>
</UserControl>
