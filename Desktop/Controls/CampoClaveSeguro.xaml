<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Clarisa.Desktop.Controls.CampoClaveSeguro" Focusable="True" IsTabStop="False">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition/>
   <ColumnDefinition Width="42"/>
  </Grid.ColumnDefinitions>
  <PasswordBox x:Name="Oculta" MaxLength="1024" AutomationProperties.Name="Contraseña" GotKeyboardFocus="ActualizarMayusculas" PreviewKeyUp="ActualizarMayusculas"/>
  <TextBox x:Name="Visible" MaxLength="1024" Visibility="Collapsed" AutomationProperties.Name="Contraseña visible" GotKeyboardFocus="ActualizarMayusculas" PreviewKeyUp="ActualizarMayusculas"/>
  <ToggleButton x:Name="Alternar" Grid.Column="1" Margin="5,0,0,0" Cursor="Hand" Checked="MostrarClave" Unchecked="OcultarClave" AutomationProperties.Name="Mostrar contraseña" ToolTip="Mostrar contraseña">
   <ToggleButton.Template>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Fondo" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
      <Path Data="M 1,9 C 5,1 15,1 19,9 C 15,17 5,17 1,9 M 13,9 A 3,3 0 1 1 7,9 A 3,3 0 1 1 13,9" Stroke="{DynamicResource AzulInstitucional}" StrokeThickness="1.5" Width="20" Height="18" Stretch="Uniform"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Fondo" Property="Background" Value="#EFF3EF"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource Foco}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Fondo" Property="Background" Value="#E6EEDC"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </ToggleButton.Template>
  </ToggleButton>
 </Grid>
</UserControl>
