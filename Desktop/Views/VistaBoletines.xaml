<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:diseno="clr-namespace:Clarisa.Desktop.Design" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Clarisa.Desktop.Views.VistaBoletines" Loaded="Cargar" d:DataContext="{d:DesignInstance Type=diseno:DatosBoletines, IsDesignTimeCreatable=True}" mc:Ignorable="d">
 <Grid Background="#F7F9F5" Margin="0">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="32,28,32,22">
   <TextBlock Text="Boletines" FontFamily="{DynamicResource FuenteEditorial}" FontSize="36"/>
   <TextBlock Text="Consulta individual de las calificaciones del año escolar." Margin="0,8,0,0" Foreground="{DynamicResource TextoSecundario}"/>
  </StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource Borde}" BorderThickness="0,1" Padding="32,18,20,6">
   <WrapPanel>
    <StackPanel Width="150" Margin="0,0,12,12"><Label Content="Año escolar" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Anios}" DisplayMemberPath="Nombre" SelectedItem="{Binding Anio}" SelectionChanged="CambiarAnio" AutomationProperties.Name="Año escolar del boletín"/></StackPanel>
    <StackPanel Width="145" Margin="0,0,12,12"><Label Content="Momento" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Lapsos}" DisplayMemberPath="Nombre" SelectedItem="{Binding Lapso}" AutomationProperties.Name="Momento del boletín"/></StackPanel>
    <StackPanel Width="125" Margin="0,0,12,12"><Label Content="Sección" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Secciones}" DisplayMemberPath="Nombre" SelectedItem="{Binding Seccion}" SelectionChanged="CambiarSeccion" AutomationProperties.Name="Sección del boletín"/></StackPanel>
    <StackPanel Width="210" Margin="0,0,12,12"><Label Content="Estudiante" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Estudiantes}" DisplayMemberPath="Nombre" SelectedItem="{Binding Estudiante}" AutomationProperties.Name="Estudiante del boletín"/></StackPanel>
    <Button Content="Consultar" Style="{StaticResource BotonPrincipal}" VerticalAlignment="Bottom" Click="Consultar" Margin="0,0,0,12"/>
   </WrapPanel>
  </Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
   <StackPanel>
   <ItemsControl ItemsSource="{Binding Paginas}" HorizontalAlignment="Center" Margin="24,24" AutomationProperties.Name="Vista previa del boletín, igual al documento que se imprime">
    <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TieneVistaPrevia}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
    <ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{DynamicResource Borde}" BorderThickness="1" Margin="0,0,0,16"><Image Source="{Binding}" MaxWidth="780" Stretch="Uniform"/></Border></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Border Background="White" BorderBrush="{DynamicResource Borde}" BorderThickness="1" Margin="32,24" Padding="24" MinWidth="800" MaxWidth="1100" VerticalAlignment="Top">
    <Border.Style>
     <Style TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding SinVistaPrevia}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <StackPanel>
     <Image Source="/Clarisa.Desktop;component/Resources/Identity/logo-liceo.png" Height="80" HorizontalAlignment="Center"/>
     <TextBlock Text="BOLETÍN INFORMATIVO" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,18,0,8"/>
     <TextBlock Text="{Binding Contexto}" HorizontalAlignment="Center" Foreground="{DynamicResource TextoSecundario}"/>
     <Border BorderBrush="{DynamicResource Borde}" BorderThickness="0,1" Margin="0,24,0,20" Padding="0,16">
      <StackPanel>
       <TextBlock Text="{Binding NombreEstudiante}" FontSize="19" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Cedula, StringFormat='Cédula: {0}'}" Margin="0,6,0,0"/>
      </StackPanel>
     </Border>
     <Grid Background="#EDF3ED" Margin="0,0,0,1">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="2*"/>
       <ColumnDefinition/>
       <ColumnDefinition/>
       <ColumnDefinition/>
       <ColumnDefinition/>
       <ColumnDefinition/>
       <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Área de formación" Margin="10,12" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="1" Text="I momento" Margin="10,12" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="2" Text="II momento" Margin="10,12" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="3" Text="III momento" Margin="10,12" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="4" Text="Defin." Margin="10,12" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="5" Text="Rev." Margin="10,12" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="6" Text="Inasist." Margin="10,12" FontWeight="SemiBold"/>
     </Grid>
     <ItemsControl ItemsSource="{Binding Filas}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1">
         <Border.Style>
          <Style TargetType="Border">
           <Style.Triggers>
            <DataTrigger Binding="{Binding EsPromedio}" Value="True">
             <Setter Property="Background" Value="#EDF3ED"/>
             <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="2*"/>
           <ColumnDefinition/>
           <ColumnDefinition/>
           <ColumnDefinition/>
           <ColumnDefinition/>
           <ColumnDefinition/>
           <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Materia}" Margin="10,14" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="1" Text="{Binding PrimerLapso}" Margin="10,14" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="2" Text="{Binding SegundoLapso}" Margin="10,14" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="3" Text="{Binding TercerLapso}" Margin="10,14" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="4" Text="{Binding Definitiva}" Margin="8,14" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="5" Text="{Binding Revision}" Margin="8,14" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="6" Text="{Binding Inasistencias}" Margin="8,14" FontSize="11" TextWrapping="Wrap"/>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{Binding AvisoResultado}" Foreground="{DynamicResource TextoSecundario}" FontSize="12" Margin="0,24,0,0"/>
     <TextBlock Text="EX: exonerado · -: no cursada · Pendiente: sin resultado · Sin consultar: momento no seleccionado" FontSize="11" Foreground="{DynamicResource TextoSecundario}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="3" Margin="32,14">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Mensaje}" Margin="0,0,18,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="Boletines de la sección" IsEnabled="{Binding PuedeExportar}" ToolTip="Un solo PDF con el boletín de cada estudiante activo de la sección, uno por página." ToolTipService.ShowOnDisabled="True" Style="{StaticResource BotonTexto}" Click="GuardarSeccion" Margin="0,0,12,0"/>
    <Button Content="Imprimir" IsEnabled="{Binding PuedeExportar}" ToolTip="Abre el boletín listo para imprimir; allí eliges la impresora." ToolTipService.ShowOnDisabled="True" Style="{StaticResource BotonTexto}" Click="Imprimir" Margin="0,0,12,0"/>
    <Button Content="Guardar PDF" IsEnabled="{Binding PuedeExportar}" ToolTip="{Binding AyudaExportacion}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource BotonPrincipal}" Click="GuardarDocumento"/>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
