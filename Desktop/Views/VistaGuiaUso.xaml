<UserControl x:Class="Clarisa.Desktop.Views.VistaGuiaUso" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PreviewKeyDown="Tecla">
 <Border Background="White" CornerRadius="16" Margin="24" Padding="30" MaxWidth="650" VerticalAlignment="Center">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,16">
    <TextBlock Text="Guía rápida" FontSize="30" FontFamily="{DynamicResource FuenteEditorial}"/>
    <TextBlock Text="{Binding TituloModulo}" FontSize="14" Foreground="{DynamicResource TextoSecundario}" Margin="0,7,0,0"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding PasosGuia}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1" Padding="0,15" Margin="0,0,12,0">
       <StackPanel><TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Texto}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextoSecundario}" LineHeight="22"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <Button x:Name="Entendido" Grid.Row="2" Content="Entendido" Style="{StaticResource BotonPrincipal}" Click="Cerrar" HorizontalAlignment="Right" Margin="0,20,0,0"/>
  </Grid>
 </Border>
</UserControl>
