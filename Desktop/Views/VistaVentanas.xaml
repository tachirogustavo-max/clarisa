<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Clarisa.Desktop.Views" xmlns:diseno="clr-namespace:Clarisa.Desktop.Design" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Clarisa.Desktop.Views.VistaVentanas" Loaded="Cargar" d:DataContext="{d:DesignInstance Type=diseno:DatosVentanas, IsDesignTimeCreatable=True}" mc:Ignorable="d">
 <Grid Background="White">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <WrapPanel Margin="32,18">
   <StackPanel Width="200" Margin="0,0,16,12"><Label Content="Año escolar" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding Anios}" DisplayMemberPath="Nombre" SelectedItem="{Binding Anio}" AutomationProperties.Name="Año de las ventanas de carga"/></StackPanel>
   <Button Content="Consultar ventanas" Style="{StaticResource BotonTexto}" Click="Consultar" VerticalAlignment="Bottom" Margin="0,0,22,12"/>
   <StackPanel Width="180" Margin="0,0,12,12"><Label Content="Momento de referencia" Style="{StaticResource Etiqueta}"/><ComboBox ItemsSource="{Binding LapsosActuales}" DisplayMemberPath="Nombre" SelectedItem="{Binding LapsoSeleccionado}" AutomationProperties.Name="Momento que se usará como actual"/></StackPanel>
   <Button Content="Usar como actual" IsEnabled="{Binding PuedeProponerActual}" Style="{StaticResource BotonTexto}" Click="PedirActual" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
  </WrapPanel>
  <local:VistaDirector MostrarCabecera="False" Grid.Row="1" DataContext="{Binding Director}">
   <local:VistaDirector.Style>
    <Style TargetType="local:VistaDirector">
     <Style.Triggers>
      <DataTrigger Binding="{Binding}" Value="{x:Null}">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </local:VistaDirector.Style>
  </local:VistaDirector>
  <StackPanel Grid.Row="2" Margin="32,16">
   <Border Background="{DynamicResource FondoError}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FaltaPolitica}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <TextBlock Text="Este año no tiene una política académica activa. Configúrala en Materias → Política del año antes de abrir la carga de notas." TextWrapping="Wrap" Foreground="{DynamicResource Error}" AutomationProperties.LiveSetting="Polite"/>
   </Border>
   <TextBlock Text="{Binding Mensaje}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <Grid Grid.RowSpan="3" Background="#88173529" xmlns:foco="clr-namespace:Clarisa.Desktop.Presentation.Behaviors" foco:FocoModal.Activo="{Binding ConfirmacionActualVisible}">
   <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ConfirmacionActualVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Border Background="White" CornerRadius="12" Padding="30" Margin="24" MaxWidth="500" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle"><StackPanel><TextBlock Text="Cambiar el momento actual" FontSize="27" FontFamily="{DynamicResource FuenteEditorial}"/><TextBlock Text="{Binding NombreActualPropuesto}" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,12"/><TextBlock Text="Se usará como referencia de trabajo. Este cambio no abre ni cierra la carga de notas." Foreground="{DynamicResource TextoSecundario}"/><WrapPanel HorizontalAlignment="Right" Margin="0,26,0,0"><Button Content="Volver" Style="{StaticResource BotonTexto}" Click="CancelarActual" Margin="0,0,12,0"/><Button Content="Confirmar cambio" Style="{StaticResource BotonPrincipal}" Click="ConfirmarActual"/></WrapPanel></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
