<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:diseno="clr-namespace:Clarisa.Desktop.Design" xmlns:conv="clr-namespace:Clarisa.Desktop.Presentation.Converters" xmlns:foco="clr-namespace:Clarisa.Desktop.Presentation.Behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Clarisa.Desktop.Views.VistaCierresResultados" Loaded="Cargar" d:DataContext="{d:DesignInstance Type=diseno:DatosCierresResultados, IsDesignTimeCreatable=True}" d:DesignWidth="1100" d:DesignHeight="700" mc:Ignorable="d">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <conv:Negacion x:Key="Invertir"/>
 </UserControl.Resources>
 <Grid Background="White">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="32,18,32,6">
   <TextBlock Text="Al cerrar se guarda una copia de las notas y definitivas de la sección con la política vigente. Mientras el cierre siga vigente, esas notas no se pueden cambiar; para corregir, anúlalo con un motivo y ciérralo de nuevo." TextWrapping="Wrap" Foreground="{DynamicResource TextoSecundario}" Margin="0,0,0,12"/>
   <WrapPanel IsEnabled="{Binding Ocupado, Converter={StaticResource Invertir}}">
    <StackPanel Width="200" Margin="0,0,16,12"><Label Content="Año escolar" Style="{StaticResource Etiqueta}" Target="{Binding ElementName=Anio}"/><ComboBox x:Name="Anio" ItemsSource="{Binding Anios}" DisplayMemberPath="Nombre" SelectedItem="{Binding Anio}" AutomationProperties.Name="Año escolar del cierre"/></StackPanel>
    <StackPanel Width="220" Margin="0,0,16,12"><Label Content="Sección" Style="{StaticResource Etiqueta}" Target="{Binding ElementName=Seccion}"/><ComboBox x:Name="Seccion" ItemsSource="{Binding Secciones}" DisplayMemberPath="Nombre" SelectedItem="{Binding Seccion}" AutomationProperties.Name="Sección del cierre"/></StackPanel>
    <Button Content="Consultar cierres" Style="{StaticResource BotonTexto}" Click="Consultar" VerticalAlignment="Bottom" Margin="0,0,16,12"/>
    <Button Content="Cerrar resultados…" Style="{StaticResource BotonPrincipal}" Click="PedirCierre" IsEnabled="{Binding PuedeCerrar}" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
   </WrapPanel>
  </StackPanel>
  <DataGrid Grid.Row="1" Margin="32,0" ItemsSource="{Binding Cierres}" SelectedItem="{Binding Seleccionado}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" AutomationProperties.Name="Cierres de la sección">
   <DataGrid.Columns>
    <DataGridTextColumn Header="N.º" Binding="{Binding Numero}" Width="60" ElementStyle="{StaticResource TextoTabla}"/>
    <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="110" ElementStyle="{StaticResource TextoTabla}"/>
    <DataGridTextColumn Header="Cerrado" Binding="{Binding Fecha}" Width="160" ElementStyle="{StaticResource TextoTabla}"/>
    <DataGridTextColumn Header="Motivo de anulación" Binding="{Binding MotivoAnulacion, TargetNullValue=—}" Width="*" ElementStyle="{StaticResource TextoTabla}"/>
   </DataGrid.Columns>
  </DataGrid>
  <WrapPanel Grid.Row="2" Margin="32,16,32,0" IsEnabled="{Binding PuedeAnular}">
   <StackPanel Width="420" Margin="0,0,16,0"><Label Content="Motivo para anular el cierre vigente" Style="{StaticResource Etiqueta}" Target="{Binding ElementName=Motivo}"/><TextBox x:Name="Motivo" Text="{Binding MotivoAnulacion, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/></StackPanel>
   <Button Content="Anular cierre" Style="{StaticResource BotonTexto}" Click="Anular" VerticalAlignment="Bottom"/>
  </WrapPanel>
  <TextBlock Grid.Row="3" Text="{Binding Mensaje}" Margin="32,14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
   <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding MensajeEsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Error}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <Grid Grid.RowSpan="4" Background="#88173529" foco:FocoModal.Activo="{Binding ConfirmacionCierreVisible}" Visibility="{Binding ConfirmacionCierreVisible, Converter={StaticResource Visible}}">
   <Border Background="White" CornerRadius="12" Padding="30" Margin="24" MaxWidth="520" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
    <StackPanel>
     <TextBlock Text="Cerrar resultados de la sección" FontSize="27" FontFamily="{DynamicResource FuenteEditorial}" TextWrapping="Wrap"/>
     <TextBlock Text="Antes hay que cerrar la carga de notas de los tres momentos y tener una política activa y completa. El boletín usará esta copia aunque después cambien notas o reglas." TextWrapping="Wrap" Foreground="{DynamicResource TextoSecundario}" Margin="0,12,0,0"/>
     <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="Volver" Style="{StaticResource BotonTexto}" Click="CancelarCierre" Margin="0,0,12,0" IsCancel="True"/>
      <Button Content="Cerrar resultados" Style="{StaticResource BotonPrincipal}" Click="Cerrar" IsEnabled="{Binding Ocupado, Converter={StaticResource Invertir}}"/>
     </WrapPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
