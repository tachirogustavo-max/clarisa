<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controles="clr-namespace:Clarisa.Desktop.Controls" xmlns:diseno="clr-namespace:Clarisa.Desktop.Design" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Clarisa.Desktop.Views.VistaMisMaterias" Loaded="Cargar" d:DataContext="{d:DesignInstance Type=diseno:DatosMisMaterias, IsDesignTimeCreatable=True}" mc:Ignorable="d">
 <Grid Background="White" Margin="32,28,32,18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="{Binding Titulo}" FontFamily="{DynamicResource FuenteEditorial}" FontSize="36"/>
   <TextBlock Text="{Binding Descripcion}" Foreground="{DynamicResource TextoSecundario}" Margin="0,8,0,26"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,26">
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition/>
    <ColumnDefinition/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,16,0">
    <Label Content="Año escolar" Style="{StaticResource Etiqueta}"/>
    <ComboBox ItemsSource="{Binding Anios}" DisplayMemberPath="Nombre" SelectedItem="{Binding Anio}" SelectionChanged="CambiarAnio" AutomationProperties.Name="Año escolar de las materias"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,16,0">
    <Label Content="Momento" Style="{StaticResource Etiqueta}"/>
    <ComboBox ItemsSource="{Binding Lapsos}" DisplayMemberPath="Nombre" SelectedItem="{Binding Lapso}" AutomationProperties.Name="Momento de la planilla"/>
   </StackPanel>
   <Button Grid.Column="2" Style="{StaticResource BotonReconsulta}" Click="Reconsultar" VerticalAlignment="Bottom" ToolTip="Volver a consultar las asignaciones sin cambiar el año ni el momento"/>
  </Grid>
  <TextBlock Text="{Binding Mensaje}" Foreground="#A52C35" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive">
   <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  </StackPanel>
  <ListBox Grid.Row="2" ItemsSource="{Binding Elementos}" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Padding" Value="0"/>
     <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Border BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="9" Padding="20">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <Border Width="34" Height="42" CornerRadius="6" Background="#E8F0E2" VerticalAlignment="Center">
        <Path Data="M1,1 H13 L17,5 V22 H1 Z M5,8 H13 M5,13 H13 M5,18 H10" Stroke="{DynamicResource Acento}" StrokeThickness="1.4" Width="17" Height="22" Stretch="Uniform"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,16,0">
        <TextBlock Text="{Binding Materia}" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Seccion}" Foreground="{DynamicResource TextoSecundario}" Margin="0,7,0,0"/>
       </StackPanel>
       <Button Grid.Column="2" Content="Abrir planilla →" Style="{StaticResource BotonTexto}" Click="Abrir" VerticalAlignment="Center"/>
      </Grid>
     </Border>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="3">
   <controles:BarraPaginacion/>
  </StackPanel>
 </Grid>
</UserControl>
