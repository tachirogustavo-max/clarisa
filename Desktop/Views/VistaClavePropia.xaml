<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Clarisa.Desktop.Controls" xmlns:m="clr-namespace:Clarisa.Desktop.Presentation.Models" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Clarisa.Desktop.Views.VistaClavePropia" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=m:ModeloClavePropia, IsDesignTimeCreatable=True}" PreviewKeyDown="Tecla">
  <UserControl.Resources>
    <Style x:Key="ErrorClave" TargetType="TextBlock" BasedOn="{StaticResource ErrorCampo}">
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Border Background="White" CornerRadius="16" Padding="30" Margin="24" MaxWidth="530" VerticalAlignment="Center">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="Tu contraseña" FontFamily="{DynamicResource FuenteEditorial}" FontSize="30"/>
          <TextBlock Text="Al cambiarla se cerrarán tus sesiones abiertas. Después entrarás con la nueva contraseña." TextWrapping="Wrap" Foreground="{DynamicResource TextoSecundario}" Margin="0,10,0,18"/>
          <StackPanel IsEnabled="{Binding Disponible}">
            <Label Content="Contraseña actual" Target="{Binding ElementName=Actual}" Style="{StaticResource Etiqueta}"/>
            <c:CampoClaveSeguro x:Name="Actual"/>
            <TextBlock Text="{Binding ErrorActual}" Style="{StaticResource ErrorClave}"/>
            <Label Content="Nueva contraseña" Target="{Binding ElementName=Nueva}" Style="{StaticResource Etiqueta}" Margin="0,18,0,0"/>
            <c:CampoClaveSeguro x:Name="Nueva"/>
            <TextBlock Text="Entre 15 y 256 caracteres. Puedes usar una frase que recuerdes." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextoSecundario}" Margin="0,7,0,0"/>
            <TextBlock Text="{Binding ErrorNueva}" Style="{StaticResource ErrorClave}"/>
            <Label Content="Repite la nueva contraseña" Target="{Binding ElementName=Confirmacion}" Style="{StaticResource Etiqueta}" Margin="0,18,0,0"/>
            <c:CampoClaveSeguro x:Name="Confirmacion"/>
            <TextBlock Text="{Binding ErrorConfirmacion}" Style="{StaticResource ErrorClave}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1">
        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="{DynamicResource TextoSecundario}" AutomationProperties.LiveSetting="Polite" Margin="0,10">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0" IsEnabled="{Binding Disponible}">
          <Button x:Name="BotonVolver" Content="Volver" Style="{StaticResource BotonTexto}" Click="Cerrar" Margin="0,0,10,8"/>
          <Button Content="Actualizar contraseña" Style="{StaticResource BotonPrincipal}" Click="Guardar" Margin="0,0,0,8"/>
        </WrapPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
