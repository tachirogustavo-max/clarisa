<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controles="clr-namespace:Clarisa.Desktop.Controls" xmlns:diseno="clr-namespace:Clarisa.Desktop.Design" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Clarisa.Desktop.Views.VistaLapsos" d:DataContext="{d:DesignInstance Type=diseno:DatosLapsos, IsDesignTimeCreatable=True}" mc:Ignorable="d">
 <UserControl.Resources>
  <DataTemplate x:Key="FormularioLapso">
   <StackPanel>
    <Label Content="Año escolar" Style="{StaticResource Etiqueta}"/>
    <ComboBox ItemsSource="{Binding Formulario.Anios}" DisplayMemberPath="Nombre" SelectedItem="{Binding Formulario.Anio}" AutomationProperties.Name="Año escolar del momento">
     <ComboBox.Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
       <Style.Triggers>
        <DataTrigger Binding="{Binding Formulario.Nuevo}" Value="False">
         <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </ComboBox.Style>
    </ComboBox>
    <TextBlock Text="{Binding Formulario[Anio]}" Style="{StaticResource ErrorCampo}" Margin="0,6,0,16"/>
    <Label Content="Nombre del momento" Style="{StaticResource Etiqueta}"/>
    <TextBox Text="{Binding Formulario.Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Nombre del momento"/>
    <TextBlock Text="{Binding Formulario[Nombre]}" Style="{StaticResource ErrorCampo}" Margin="0,6,0,16"/>
    <Label Content="Orden" Style="{StaticResource Etiqueta}"/>
    <ComboBox ItemsSource="{Binding Formulario.Ordenes}" SelectedItem="{Binding Formulario.Orden}" AutomationProperties.Name="Orden del momento"/>
    <TextBlock Text="{Binding Formulario[Orden]}" Style="{StaticResource ErrorCampo}" Margin="0,6,0,16"/>
    <Label Content="Fecha de inicio" Style="{StaticResource Etiqueta}"/>
    <DatePicker SelectedDate="{Binding Formulario.Inicio}" AutomationProperties.Name="Fecha de inicio del momento"/>
    <TextBlock Text="{Binding Formulario[Inicio]}" Style="{StaticResource ErrorCampo}" Margin="0,6,0,16"/>
    <Label Content="Fecha de finalización" Style="{StaticResource Etiqueta}"/>
    <DatePicker SelectedDate="{Binding Formulario.Fin}" AutomationProperties.Name="Fecha de finalización del momento"/>
    <TextBlock Text="{Binding Formulario[Fin]}" Style="{StaticResource ErrorCampo}"/>
   </StackPanel>
  </DataTemplate>
 </UserControl.Resources>
 <controles:ListadoCatalogo Editor="{StaticResource FormularioLapso}">
  <controles:ListadoCatalogo.Columnas>
   <DataGridTextColumn ElementStyle="{StaticResource TextoTabla}" Header="Orden" Binding="{Binding Orden}" MinWidth="90" Width="90"/>
   <DataGridTextColumn ElementStyle="{StaticResource TextoTabla}" Header="Momento" Binding="{Binding Nombre}" Width="*" MinWidth="180"/>
   <DataGridTextColumn ElementStyle="{StaticResource TextoTabla}" Header="Inicio" Binding="{Binding Inicio, StringFormat=dd/MM/yyyy}" MinWidth="145" Width="145"/>
   <DataGridTextColumn ElementStyle="{StaticResource TextoTabla}" Header="Finalización" Binding="{Binding Fin, StringFormat=dd/MM/yyyy}" MinWidth="145" Width="145"/>
   <DataGridCheckBoxColumn ElementStyle="{StaticResource CasillaConsulta}" Header="Actual" Binding="{Binding EsActual}" MinWidth="90" Width="90"/>
  </controles:ListadoCatalogo.Columnas>
 </controles:ListadoCatalogo>
</UserControl>
