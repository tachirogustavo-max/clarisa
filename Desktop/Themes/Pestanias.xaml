<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="TabControl">
  <Setter Property="Foreground" Value="{DynamicResource Tinta}"/>
  <Setter Property="Background" Value="White"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TabControl">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition/>
      </Grid.RowDefinitions>
      <Border x:Name="CabeceraPestanias" BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1" Padding="24,0" SnapsToDevicePixels="True">
       <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
      </Border>
      <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
     </Grid>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="TabItem">
  <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
  <Setter Property="Padding" Value="18,15"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TabItem">
     <Border x:Name="Marco" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,3" Background="Transparent">
      <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Acento}"/>
       <Setter Property="Foreground" Value="{DynamicResource Acento}"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter TargetName="Marco" Property="Background" Value="#EAF1F6"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Marco" Property="Background" Value="#F1F5EB"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource Tinta}"/>
  <Setter Property="MinHeight" Value="30"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="CheckBox">
     <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="21"/>
       <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Border x:Name="Marco" Width="18" Height="18" VerticalAlignment="Center" Background="White" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="4">
       <Path x:Name="Marca" Data="M1,5 L5,9 L12,1" Stroke="White" StrokeThickness="1.8" Visibility="Collapsed" Margin="2"/>
      </Border>
      <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Marco" Property="Background" Value="{DynamicResource Acento}"/>
       <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Foco}"/>
       <Setter TargetName="Marco" Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.55"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="CasillaConsulta" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/></Style>
</ResourceDictionary>
