<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="BotonReconsulta" TargetType="Button" BasedOn="{StaticResource BotonTexto}">
  <Setter Property="Width" Value="44"/>
  <Setter Property="Height" Value="44"/>
  <Setter Property="Padding" Value="10"/>
  <Setter Property="Content" Value="Volver a consultar"/>
  <Setter Property="ToolTip" Value="Volver a consultar los cambios del servidor"/>
  <Setter Property="AutomationProperties.Name" Value="Volver a consultar"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
   <Path Data="M18,7 A8,8 0 1 0 19,15 M18,1 L18,7 L12,7" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource Acento}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
  </DataTemplate></Setter.Value></Setter>
  <Style.Triggers><DataTrigger Binding="{Binding Cargando}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
 </Style>
</ResourceDictionary>
