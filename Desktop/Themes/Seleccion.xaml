<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitivas="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
 <Style TargetType="ComboBoxItem">
  <Setter Property="Padding" Value="12,10"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Foreground" Value="{DynamicResource Tinta}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="Fondo" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
       <Setter TargetName="Fondo" Property="Background" Value="#E8F0E2"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Fondo" Property="Background" Value="#DCEADA"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.5"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="MinHeight" Value="40"/>
  <Setter Property="Background" Value="{DynamicResource FondoCampo}"/>
  <Setter Property="Foreground" Value="{DynamicResource Tinta}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Borde}"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
       <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
         <Border x:Name="Marco" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="6">
          <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Tinta}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
           <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Acento}"/>
          </Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" Margin="12,8,35,8" VerticalAlignment="Center"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
       <Border Background="White" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="7" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
         <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
        </ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter Property="BorderBrush" Value="{DynamicResource Foco}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.55"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="DatePicker">
  <Setter Property="MinHeight" Value="44"/>
  <Setter Property="Foreground" Value="{DynamicResource Tinta}"/>
  <Setter Property="SelectedDateFormat" Value="Short"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DatePicker">
     <Border x:Name="Marco" Background="{DynamicResource FondoCampo}" BorderBrush="{DynamicResource Borde}" BorderThickness="1" CornerRadius="7">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="42"/>
       </Grid.ColumnDefinitions>
       <primitivas:DatePickerTextBox x:Name="PART_TextBox" Foreground="{TemplateBinding Foreground}" Padding="12,10" VerticalContentAlignment="Center">
        <primitivas:DatePickerTextBox.Template>
         <ControlTemplate TargetType="primitivas:DatePickerTextBox">
          <ScrollViewer x:Name="PART_ContentHost" Margin="12,10"/>
         </ControlTemplate>
        </primitivas:DatePickerTextBox.Template>
       </primitivas:DatePickerTextBox>
       <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource BotonTexto}" Padding="9" BorderThickness="0" AutomationProperties.Name="Abrir calendario">
        <Path Data="M1,4 H19 V20 H1 Z M1,9 H19 M5,0 V6 M15,0 V6" Stroke="{DynamicResource Acento}" StrokeThickness="1.5" Width="18" Height="20" Stretch="Uniform"/>
       </Button>
       <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource Foco}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.55"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
</ResourceDictionary>
